{
  "name": "mcsquishy",
  "version": "0.1.0",
  "private": true,
  "description": "McSquishy: Blob on the Run",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run src/placeholder.test.ts && node --import tsx --test $(find src -name '*.test.ts' ! -name 'placeholder.test.ts')",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.2",
    "tsx": "^4.23.12",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
